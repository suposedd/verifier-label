{
	"geode": "5.11.2",
	"gd": {
		"win": "2.2081",
		"android": "2.2081",
		"mac": "2.2081",
		"ios": "2.2081"
	},
	"id": "suposed.verifier-label",
	"name": "Verifier Label",
	"version": "v1.0.0",
	"settings":{
		"mod-title": {
			"type": "title",
			"name": "General Settings"
		},
		"enabled": {
			"type": "bool",
			"name": "Enabled",
			"description": "Toggle mod's functionality",
			"default": true
		},
		"x-offset": {
			"type": "float",
			"name": "X Offset",
			"description": "Label's offset on X axis",
			"min": -30,
			"max": 30,
			"default": 0
		},
		"y-offset": {
			"type": "float",
			"name": "Y Offset",
			"description": "Label's offset on Y axis",
			"min": -10,
			"max": 10,
			"default": 3
		},
		"scale": {
			"type": "float",
			"name": "Label Scale",
			"description": "Verifier label's size",
			"min": 0.1,
			"max": 1,
			"default": 0.45
		},
		"enable-yt-button": {
			"type": "bool",
			"name": "Enable Youtube Button",
			"description": "Toggle the youtube button's visibility",
			"default": true
		}
	},
	"developer": "suposed",
	"description": "",
	"dependencies": {
		"geode.node-ids": ">=v1.23.3"
	}
}
